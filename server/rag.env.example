# Environment file for the rag.service systemd unit.
# Copy to /upload/rag/rag.env and edit as needed.

# Bind
HOST=127.0.0.1
PORT=8100

# Auth: leave commented to disable (relies on Apache exposure boundary).
# Set to enable X-API-Key enforcement on every non-health endpoint.
#API_KEY=changeme-please

# Downstream LiteLLM
LITELLM_URL=http://127.0.0.1:4000
# Must match /upload/litellm/litellm.env's LITELLM_MASTER_KEY
LITELLM_API_KEY=sk-1234
DEFAULT_MODEL=qwen2.5-7b

# Embeddings (CPU)
EMBED_MODEL_NAME=intfloat/multilingual-e5-base
EMBED_BATCH_SIZE=32

# Chunking / retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MIN_SCORE=0.0

# Generation defaults
RAG_TEMPERATURE=0.2
RAG_MAX_TOKENS=1024

# Intent Router (Issue #37, P5 v3)
# Master switch. When False (default), POST /router/v1/chat/completions
# plain-proxies to LiteLLM (safe rollout baseline).
# When True, the endpoint runs the classifier + dispatches to plain/rag/ontology.
# INTENT_ROUTER_ENABLED=false

# Shadow mode: run classifier + dispatch but log-only (no user impact).
# Reserved for step 5 observability rollout.
# INTENT_ROUTER_SHADOW=false

# Comma-separated list of model names routed through the classifier.
# Only these models get intent classification. Others plain-proxy.
# INTENT_ROUTER_ALLOWED_MODELS=qwen2.5-auto

# Comma-separated list of model names that always bypass the router
# (e.g. autocomplete completions where classification is meaningless).
# INTENT_ROUTER_BYPASS_MODELS=mellum-4b

# Fallback route when the classifier is uncertain.
# One of: plain | rag | ontology
# INTENT_ROUTER_DEFAULT=plain
