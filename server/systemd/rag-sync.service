# /etc/systemd/system/rag-sync.service
# Companion service to rag-sync.timer.
# Manual invocation: sudo systemctl start rag-sync.service
[Unit]
Description=RAG daily document sync (Smart Client pipeline)
Documentation=https://github.com/hjoong-tangunsoft/RAG_maker/blob/RAG_maker/docs/DESIGN_PRINCIPLES.md
After=rag.service network-online.target
Requires=rag.service

[Service]
Type=oneshot
User=rocky
Group=rocky
WorkingDirectory=/upload/rag
Environment=PYTHONUNBUFFERED=1
Environment=POOL_DIR=/upload/rag/data/docs-pool
Environment=STATE_FILE=/upload/rag/data/sync-state.json
Environment=RAG_URL=http://127.0.0.1:8100/rag/ingest/text
Environment=DAILY_LIMIT=2
ExecStart=/upload/rag/venv/bin/python3 /upload/rag/scripts/rag_sync.py
StandardOutput=journal
StandardError=journal
# Resource hints - light CPU, single shot
CPUQuota=200%
MemoryMax=1G
TimeoutStartSec=600
